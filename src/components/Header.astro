---
/**
 * F0 顶部导航：品牌名 + 板块锚点导航 + 语言切换 + 移动端折叠菜单
 * 导航项由 sections.config 注册表驱动（顺序 / 显隐）
 */
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import type { SiteData } from '../i18n/load';

export interface Props {
  data: SiteData;
}
const { data } = Astro.props;
const t = (k: string) => data.ui[k] ?? k;
const visibleSections = data.sections.filter((s) => s.visible);
const langBase = data.locale.short === 'zh' ? '' : `/${data.locale.short}`;
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a href={`${langBase}/#top`} class="brand" data-nav-link>
      <span class="brand-dot" aria-hidden="true"></span>
      <span class="brand-name">{data.profile.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="primary">
      {
        visibleSections.map((s) => (
          <a href={`${langBase}/#${s.id}`} class="nav-link" data-nav-link data-section-link={s.id}>
            {t(`nav.${s.id}`)}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <LangSwitch data={data} />
      <button
        class="menu-btn"
        type="button"
        data-menu-btn
        data-open-label={t('a11y.menu')}
        data-close-label={t('a11y.closeMenu')}
        aria-label={t('a11y.menu')}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <!-- 移动端折叠面板 -->
  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <nav class="mobile-nav-inner" aria-label="mobile">
      {
        visibleSections.map((s) => (
          <a href={`${langBase}/#${s.id}`} class="mobile-nav-link" data-nav-link data-section-link={s.id}>
            {t(`nav.${s.id}`)}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur-mid) var(--ease-out),
      background var(--dur-mid) var(--ease-out);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--color-border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: var(--header-height);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 700;
    font-size: 17px;
    color: var(--color-text);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .brand:hover {
    color: var(--color-text);
  }
  .brand-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent-teal));
    box-shadow: 0 0 0 4px var(--color-primary-soft);
    flex: none;
  }
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    margin-right: var(--space-4);
  }
  .nav-link {
    position: relative;
    padding: 8px 13px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 13px;
    right: 13px;
    bottom: 3px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-mid) var(--ease-out);
  }
  .nav-link:hover {
    color: var(--color-primary);
  }
  .nav-link.is-active {
    color: var(--color-primary);
    font-weight: 600;
  }
  .nav-link.is-active::after {
    transform: scaleX(1);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .menu-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .mobile-nav {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .mobile-nav-inner {
    display: flex;
    flex-direction: column;
    padding: var(--space-2) 20px var(--space-4);
  }
  .mobile-nav-link {
    padding: 13px 6px;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-nav-link:last-child {
    border-bottom: none;
  }
  .mobile-nav-link.is-active {
    color: var(--color-primary);
  }

  @media (max-width: 860px) {
    .desktop-nav {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
</style>
