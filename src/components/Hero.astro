---
/**
 * F1 个人简介区：头像 / 姓名 / 头衔 / 单位 / 简介 / 学术链接 / CV
 */
import Icon from './Icon.astro';
import HeroDecor from './HeroDecor.astro';
import type { SiteData } from '../i18n/load';

export interface Props {
  data: SiteData;
}
const { data } = Astro.props;
const { profile, ui } = data;
const t = (k: string) => ui[k] ?? k;
const langBase = data.locale.short === 'zh' ? '' : `/${data.locale.short}`;
const zh = data.locale.short === 'zh';
// 英文版将姓氏 Chen 加粗突出
const nameParts = zh ? null : profile.name.split(/(Chen)/g);
---

<section class="hero" id="top">
  <HeroDecor />
  <div class="container hero-inner">
    <div class="hero-text" data-reveal>
      {
        profile.affiliation && (
          <p class="hero-eyebrow">
            <span class="eyebrow-bar" aria-hidden="true"></span>
            {profile.affiliation}
          </p>
        )
      }
      <h1 class="hero-name">
        {zh ? profile.name : nameParts!.map((p) => (p === 'Chen' ? <strong class="name-family">Chen</strong> : p))}
      </h1>
      <p class="hero-title">
        {profile.title.split('\n').map((line) => <span class="hero-title-line">{line}</span>)}
      </p>

      <blockquote class="hero-bio">
        <span class="hero-quote-mark" aria-hidden="true">&ldquo;</span>
        {
          profile.bio.map((para) => {
            const isAttr = /^[\u2014\u2013-]+/.test(para.trim());
            return <p class={isAttr ? 'hero-bio-attr' : 'hero-bio-text'}>{para}</p>;
          })
        }
      </blockquote>

      {
        profile.address && (
          <div class="hero-meta">
            <span class="hero-location">
              <Icon name="pin" size={15} /> {profile.address}
            </span>
          </div>
        )
      }

      <div class="hero-actions">
        <a class="btn btn-primary" href={`mailto:${profile.email}`}>
          <Icon name="mail" size={17} />
          <span>{profile.email}</span>
        </a>
        {
          profile.cvFile && (
            <a class="btn btn-ghost" href={profile.cvFile} download>
              <Icon name="download" size={17} />
              <span>{t('hero.cv')}</span>
            </a>
          )
        }
      </div>

      <div class="hero-links">
        {
          profile.links.map((l) => (
            <a
              class="icon-link"
              href={l.url}
              target="_blank"
              rel="noopener noreferrer"
              title={l.label}
              aria-label={l.label}
            >
              <Icon name={l.icon} size={20} />
            </a>
          ))
        }
      </div>
    </div>

    <div class="hero-visual" data-reveal style="--reveal-delay: 120ms">
      <div class="avatar-ring" aria-hidden="true"></div>
      <img
        class="hero-avatar"
        src={profile.avatar}
        alt={profile.name}
        width="320"
        height="320"
        loading="eager"
        fetchpriority="high"
      />
      <div class="avatar-badge" aria-hidden="true">
        <Icon name="scholar" size={18} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: calc(var(--space-8) + 24px) 0 var(--space-8);
    overflow: hidden;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-7);
    align-items: center;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-primary);
    background: var(--color-primary-soft);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    margin: 0 0 var(--space-4);
  }
  .eyebrow-bar {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent-amber);
  }
  .hero-name {
    font-family: var(--font-heading);
    font-size: clamp(34px, 5vw, 46px);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }
  .hero-name .name-family {
    font-weight: 800;
  }
  /* 英文名整体用 Georgia Bold，姓氏 Chen 用更重的字重突出 */
  :global(html[lang='en']) .hero-name {
    font-weight: 700;
  }
  :global(html[lang='en']) .hero-name .name-family {
    font-weight: 800;
  }
  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(17px, 2.2vw, 20px);
    font-weight: 600;
    color: var(--color-accent-teal);
    margin-bottom: var(--space-5);
    white-space: pre-line;
  }
  .hero-title-line {
    display: block;
  }
  /* 英文版头衔：非加粗，桌面端固定两行（单位行 / 学位行各占一行） */
  :global(html[lang='en']) .hero-title {
    font-weight: 400;
    font-size: clamp(15px, 1.5vw, 18px);
    line-height: 1.55;
  }
  @media (min-width: 901px) {
    :global(html[lang='en']) .hero-title-line {
      white-space: nowrap;
    }
  }
  .hero-bio {
    position: relative;
    margin: 0 0 var(--space-5);
    padding: 20px 22px 18px 26px;
    max-width: 60ch;
    background: var(--color-primary-softer);
    border-left: 3px solid var(--color-primary);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(16px, 2vw, 18px);
    line-height: 1.75;
    color: var(--color-text);
  }
  .hero-quote-mark {
    position: absolute;
    top: -12px;
    left: 10px;
    font-family: var(--font-serif);
    font-size: 56px;
    line-height: 1;
    color: var(--color-primary);
    opacity: 0.18;
    pointer-events: none;
  }
  .hero-bio-text {
    margin: 0;
  }
  .hero-bio-attr {
    margin: 10px 0 0;
    font-family: var(--font-sans);
    font-style: normal;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-text-faint);
    text-align: right;
  }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    color: var(--color-text-faint);
    font-size: 14px;
  }
  .hero-location {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: var(--space-5);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    padding: 11px 22px;
    border-radius: var(--radius-pill);
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    border: 1px solid transparent;
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .btn-primary {
    background: var(--color-primary);
    color: #fff;
    box-shadow: 0 4px 14px rgba(59, 91, 219, 0.28);
  }
  .btn-primary:hover {
    color: #fff;
    background: var(--color-primary-strong);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(59, 91, 219, 0.36);
  }
  .btn-ghost {
    background: var(--color-surface);
    color: var(--color-primary);
    border-color: var(--color-border-strong);
  }
  .btn-ghost:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }
  @media (max-width: 600px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .hero-actions .btn {
      width: 100%;
    }
  }
  .hero-links {
    display: flex;
    gap: var(--space-2);
  }
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    transition:
      transform var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .icon-link:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }
  .hero-visual {
    position: relative;
    justify-self: center;
    width: clamp(220px, 24vw, 300px);
    aspect-ratio: 1;
  }
  .hero-avatar {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 32% 68% 62% 38% / 38% 38% 62% 62%;
    object-fit: cover;
    object-position: 60% 50%;
    border: 5px solid var(--color-surface);
    box-shadow: var(--shadow-card-hover);
  }
  .avatar-ring {
    position: absolute;
    inset: -14px;
    border-radius: 40% 60% 58% 42% / 45% 42% 58% 55%;
    border: 2px dashed var(--color-primary);
    opacity: 0.35;
    animation: spin-slow 30s linear infinite;
  }
  .avatar-badge {
    position: absolute;
    z-index: 2;
    right: -6px;
    bottom: 6px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-amber);
    color: #fff;
    border: 4px solid var(--color-bg);
    box-shadow: var(--shadow-card);
  }
  @keyframes spin-slow {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .hero-visual {
      order: -1;
      width: 180px;
    }
    .hero-bio {
      max-width: none;
    }
  }
</style>
